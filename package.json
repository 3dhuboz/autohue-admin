{
  "name": "autohue-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "cd workers/api && npx wrangler dev",
    "worker:deploy": "cd workers/api && npx wrangler deploy",
    "db:create": "cd workers/api && npx wrangler d1 create autohue-db",
    "db:migrate": "cd workers/api && npx wrangler d1 execute autohue-db --file=schema.sql",
    "db:migrate:local": "cd workers/api && npx wrangler d1 execute autohue-db --local --file=schema.sql"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.18.0",
    "@paypal/react-paypal-js": "^8.8.3",
    "jszip": "^3.10.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
